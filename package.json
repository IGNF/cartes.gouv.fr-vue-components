{
  "name": "@ignf/cartes.gouv.fr-vue-components",
  "private": false,
  "version": "1.4.5",
  "publishConfig": {
    "@ignf:registry": "https://npm.pkg.github.com",
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "import": {
        "default": "./dist/index.js"
      }
    },
    "./dist/index.css": {
      "import": "./dist/index.css"
    },
    "./styles": {
      "import": "./dist/index.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test-storybook": "vitest run --project storybook",
    "lint": "eslint . --ext .js,.vue --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.vue --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@gouvfr/dsfr": "1.14.4",
    "@gouvminint/vue-dsfr": "^8.16.1",
    "@vueuse/core": "^14.2.1",
    "codemirror": "^6.0.2",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@eslint/js": "^10.0.1",
    "@gouvfr/dsfr": "1.14.4",
    "@gouvminint/vue-dsfr": "^8.16.1",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.12",
    "@vueuse/core": "^14.2.1",
    "codemirror": "^6.0.2",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "playwright": "^1.65.1",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.98.0",
    "storybook": "^10.6.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.12",
    "vue": "^3.5.0",
    "vue-router": "^5.5.1"
  }
}
